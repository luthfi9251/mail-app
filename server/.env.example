# --- required ---
MONGODB_URI=mongodb://emailapp:change-me@localhost:27017/email-app?authSource=admin
RESEND_API_KEY=re_xxxxxxxxxxxx
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
MAILBOX_DOMAIN=example.com

# --- optional ---
PORT=8080
# Required to create the first admin from the setup screen; remove after setup.
SETUP_TOKEN=
# Resend webhook signing secret (whsec_...). Webhook route is currently disabled in main.go.
RESEND_WEBHOOK_SECRET=
# Set to false ONLY for local development over plain HTTP.
COOKIE_SECURE=true
# Comma-separated origins allowed to call the API cross-origin (usually none).
CORS_ORIGINS=
# Comma-separated reverse-proxy IPs/CIDRs to trust for X-Forwarded-For.
TRUSTED_PROXIES=
# Directory of the built web app.
STATIC_DIR=../web/dist
