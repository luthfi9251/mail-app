# Copy to docker.env (git-ignored) and fill in. Used by docker-compose.yml.

# --- required ---
# Shared MongoDB, reached through the host IP (same as the v1 app uses).
MONGODB_URI=mongodb://USER:PASSWORD@10.0.0.1:27017/?authSource=admin
RESEND_API_KEY=re_xxxxxxxxxxxx
# At least 32 random characters: openssl rand -hex 32
JWT_SECRET=
MAILBOX_DOMAIN=example.com

# --- production ---
# Served over HTTPS (Cloudflare), so keep cookies Secure.
COOKIE_SECURE=true
# Requests arrive via cloudflared over Docker networks; trusting those ranges
# lets rate limiting use the real client IP from X-Forwarded-For instead of
# putting every user in one bucket.
TRUSTED_PROXIES=172.16.0.0/12

# --- optional ---
# Set only to create the first admin on an empty database, then remove.
SETUP_TOKEN=
CORS_ORIGINS=
